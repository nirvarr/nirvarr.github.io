<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Generated from data/*.yml by scripts/build.py. Edit the data, not the output. #}
<title>{{ p.page_title }}</title>
<meta name="description" content="{{ p.meta_description }}">
<meta property="og:title" content="{{ p.name }}">
<meta property="og:description" content="{{ p.share_description }}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&amp;family=Source+Sans+3:ital,wght@0,400;0,600;1,400&amp;display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='16' fill='%231D4E89'/%3E%3C/svg%3E">
<style>
:root{
  --ink:#1C2024;
  --muted:#5B6470;
  --accent:#1D4E89;
  --accent-dark:#0F2F57;
  --rule:#E3E7EC;
  --chip:#DCE3EC;
  --wash:#F5F7FA;
  --paper:#FFFFFF;
  --serif:"Source Serif 4",Georgia,serif;
  --sans:"Source Sans 3",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.7 var(--sans);-webkit-font-smoothing:antialiased}
a{color:var(--accent);text-decoration-thickness:1px;text-underline-offset:.18em}
a:hover{color:var(--accent-dark)}
a:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:2px}
.skip{position:absolute;left:-999px}
.skip:focus{left:1rem;top:1rem;background:var(--paper);padding:.5rem 1rem;z-index:10}
.col{max-width:47.5rem;margin:0 auto;padding-inline:2rem}

/* profile header */
.profile{background:var(--wash);border-bottom:1px solid var(--rule)}
.profile .col{display:flex;flex-direction:column;align-items:center;text-align:center;gap:1rem;padding-block:3.5rem 2.5rem}
.avatar{width:9.5rem;height:9.5rem;border-radius:50%;background:var(--chip);border:4px solid var(--paper);display:flex;align-items:center;justify-content:center;font:400 2.6rem/1 var(--serif);color:var(--accent);object-fit:cover}
.who{display:flex;flex-direction:column;gap:.25rem}
.who h1{margin:0;font:600 2.125rem/1.25 var(--serif)}
.who p{margin:0;font-size:1.125rem;color:var(--muted)}
.links{display:flex;flex-wrap:wrap;justify-content:center;gap:.4rem 1.5rem;margin:0;padding:0;list-style:none;font-size:.95rem}

/* nav */
.site-nav{border-top:1px solid var(--rule);background:var(--paper)}
.site-nav ul{display:flex;flex-wrap:wrap;justify-content:center;gap:.25rem 2.25rem;margin:0 auto;padding:.875rem 2rem;list-style:none;max-width:47.5rem}
.site-nav a{color:var(--muted);text-decoration:none}
.site-nav a:hover{color:var(--ink)}
.site-nav a[aria-current]{color:var(--ink);font-weight:600}

/* content */
main.col{display:flex;flex-direction:column;gap:3rem;padding-block:3.5rem 5rem}
section{display:flex;flex-direction:column;gap:1rem;scroll-margin-top:1.5rem}
h2{margin:0;font:600 1.375rem/1.3 var(--serif)}
#about h2{font-size:2rem;line-height:1.25}
p{margin:0;max-width:38em}
.signoff{font-style:italic;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}
.chips li{font-size:.95rem;padding:.25rem .875rem;border:1px solid var(--chip);border-radius:999px}
.news{display:grid;grid-template-columns:5.5rem 1fr;gap:.5rem 1rem;margin:0;font-size:1rem}
.news dt{color:var(--muted)}
.news dd{margin:0}
.entries{display:flex;flex-direction:column;gap:1rem;font-size:1rem}
.entries p{max-width:40em}

.cv-links{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1.5rem}
.btn{display:inline-flex;align-items:center;min-height:2.75rem;padding:0 1.125rem;border-radius:.375rem;background:var(--accent);color:#FFFFFF;text-decoration:none;font-weight:600}
.btn:hover{background:var(--accent-dark);color:#FFFFFF}
footer{border-top:1px solid var(--rule)}
footer p{max-width:none;padding-block:1.5rem;font-size:.875rem;color:var(--muted);text-align:center}

@media (max-width:30rem){
  .col{padding-inline:1.25rem}
  .who h1{font-size:1.75rem}
  .news{grid-template-columns:1fr;gap:0}
  .news dd{margin-bottom:.75rem}
}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="profile">
  <div class="col">
    <img class="avatar" src="{{ p.photo | trim('/') }}" width="152" height="152" alt="Portrait of {{ p.name }}">
    <div class="who">
      <h1>{{ p.name }}</h1>
      <p>{{ p.headline }} · {{ p.location }}</p>
    </div>
    <ul class="links">
      <li><a href="mailto:{{ p.email_site }}">{{ p.email_site }}</a></li>
      <li><a href="{{ p.scholar }}">Google Scholar</a></li>
      <li><a href="{{ p.github }}">GitHub</a></li>
      <li><a href="{{ p.linkedin }}">LinkedIn</a></li>
      <li><a href="{{ cv_file }}">CV (PDF)</a></li>
    </ul>
  </div>
  <nav class="site-nav" aria-label="Site">
    <ul>
      <li><a href="#about" aria-current="page">About</a></li>
      <li><a href="#publications">Publications</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#cv">CV</a></li>
    </ul>
  </nav>
</header>

<main id="main" class="col">

  <section id="about" aria-labelledby="about-h">
    <h2 id="about-h">About</h2>
{% for para in p.about %}
    <p>{{ para | md }}</p>
{% endfor %}
    <p class="signoff">{{ p.first_name }}</p>
  </section>

  <section aria-labelledby="interests-h">
    <h2 id="interests-h">Research interests</h2>
    <ul class="chips">
{% for i in p.interests %}
      <li>{{ i }}</li>
{% endfor %}
    </ul>
  </section>
{% if news %}

  <section aria-labelledby="news-h">
    <h2 id="news-h">News</h2>
    <dl class="news">
{% for n in news %}
      <dt>{{ n.date }}</dt><dd>{{ n.text | md }}</dd>
{% endfor %}
    </dl>
  </section>
{% endif %}

  <section id="publications" aria-labelledby="pubs-h">
    <h2 id="pubs-h">Publications</h2>
    <div class="entries">
{% for pub in pubs %}
      <p>{{ pub.authors_marked | md }}. {{ pub.title | md }}. {{ pub.status_text | md }}{% for l in pub.links %} <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>
{% endfor %}
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-h">
    <h2 id="projects-h">Projects</h2>
    <div class="entries">
{% for pr in site_projects %}
      <p><strong>{{ pr.title }}</strong> ({{ pr.years }}). {{ pr.summary | md }}{% for l in pr.links %} <a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</p>
{% endfor %}
    </div>
  </section>

  <section id="cv" aria-labelledby="cv-h">
    <h2 id="cv-h">CV</h2>
    <p>My two-page academic CV covers education, research experience, publications, projects and skills.</p>
    <p class="cv-links"><a class="btn" href="{{ cv_file }}" download>Download CV (PDF)</a> <a href="{{ cv_file }}" target="_blank" rel="noopener">Open in a new tab</a></p>
  </section>

</main>

<footer>
  <p>© {{ year }} {{ p.name }}</p>
</footer>
</body>
</html>
